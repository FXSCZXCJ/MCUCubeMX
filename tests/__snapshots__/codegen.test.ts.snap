#include "gd32l23x.h"
#include "gpio.h"


void EXTI10_15_IRQHandler(void)
{

    if (RESET != exti_interrupt_flag_get(EXTI_13)) {
        exti_interrupt_flag_clear(EXTI_13);
        /* USER CODE BEGIN EXTI10_15_EXTI13 */
        /* USER CODE END EXTI10_15_EXTI13 */
    }

}

"
