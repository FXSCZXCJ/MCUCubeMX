"/* USER CODE BEGIN Header */
/**
  ******************************************************************************
  * @file    gpio.h
  * @brief   GPIO 引脚定义 - 由 MCUCubeMX 自动生成
  * @target  GD32L233RCT6
  * @note    重新生成时本文件会被覆盖，请把手写代码放在 USER CODE 区段内
  ******************************************************************************
  */
/* USER CODE END Header */

#ifndef __GPIO_H
#define __GPIO_H

#include "gd32l23x.h"


/* ==================== LED ==================== */

#define LED_R_Pin         GPIO_PIN_5
#define LED_R_GPIO_Port   GPIOA


/* ==================== KEY ==================== */

#define KEY_USER_Pin         GPIO_PIN_13
#define KEY_USER_GPIO_Port   GPIOC


/* ==================== UNLABELED ==================== */

#define PA0_Pin         GPIO_PIN_0
#define PA0_GPIO_Port   GPIOA



/* 初始化函数声明 */
void MX_GPIO_Init(void);

void MX_EXTI_Init(void);


#endif /* __GPIO_H */
"
