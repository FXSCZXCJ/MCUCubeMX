exports[`代码生成 (sample-project) > 生成内容与快照一致 2`] = `
"/**
  ******************************************************************************
  * @file    gpio.c
  * @brief   GPIO 初始化 - 由 MCUCubeMX 自动生成
  * @target  GD32L233RCT6
  ******************************************************************************
  */

#include "gpio.h"

/**
  * @brief  初始化 GPIO 引脚
  */
void MX_GPIO_Init(void)
{
    /* 使能 GPIO 时钟 */

    rcu_periph_clock_enable(RCU_GPIOA);

    rcu_periph_clock_enable(RCU_GPIOC);


    /* ============ 输出引脚 ============ */

    /* LED_R (PA5) */
    gpio_mode_set(GPIOA, GPIO_MODE_OUTPUT, GPIO_PUPD_NONE, GPIO_PIN_5);
    gpio_output_options_set(GPIOA, GPIO_OTYPE_PP, GPIO_OSPEED_50MHZ, GPIO_PIN_5);
    gpio_bit_set(GPIOA, GPIO_PIN_5);


    /* ============ 输入引脚 ============ */

    /* KEY_USER (PC13) */
    gpio_mode_set(GPIOC, GPIO_MODE_INPUT, GPIO_PUPD_PULLDOWN, GPIO_PIN_13);


    /* PA0 (PA0) */
    gpio_mode_set(GPIOA, GPIO_MODE_INPUT, GPIO_PUPD_NONE, GPIO_PIN_0);


}


/**
  * @brief  初始化外部中断（EXTI）
  * @note   Cortex-M23 优先级分组固定，nvic_irq_enable 仅需一个优先级参数
  */
void MX_EXTI_Init(void)
{

    /* KEY_USER (PC13) */
    exti_init(EXTI_13, EXTI_INTERRUPT, EXTI_TRIG_FALLING);



    nvic_irq_enable(EXTI10_15_IRQn, 0);

}

"
`;

exports[`代码生成 (sample-project) > 生成内容与快照一致 3`] = `
